# --- SSH connection to the host running Docker ---
SSH_HOST=server.example.com
SSH_PORT=22
SSH_USER=debug

# Pick ONE auth method (key is recommended). If none is set, the SSH agent is used.
SSH_PRIVATE_KEY=/home/me/.ssh/id_ed25519
# SSH_PRIVATE_KEY_DATA="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# SSH_PASSPHRASE=changeme
# SSH_PASSWORD=changeme

# --- Safety / behaviour ---
# Allow start/stop/restart lifecycle tools (still no delete/prune, ever). Off by default.
# ALLOW_LIFECYCLE=false
# Disable the guarded docker_exec tool entirely.
# ALLOW_EXEC=true
# Extra binaries allowed inside docker_exec (comma separated), added to the safe default set.
# EXEC_ALLOWLIST=curl,redis-cli
# Only these containers may be touched (comma separated names/ids). Empty = all.
# ALLOWED_CONTAINERS=api,worker,web
# Never touch these containers (comma separated). Takes precedence over the allowlist.
# DENIED_CONTAINERS=postgres,mysql,vault
# Prefix every docker command with `sudo -n` (host where the SSH user needs sudo for docker).
# USE_SUDO=false
# Per-command timeout in milliseconds.
# COMMAND_TIMEOUT_MS=30000
# Truncate command output to at most this many bytes.
# MAX_OUTPUT_BYTES=1000000
